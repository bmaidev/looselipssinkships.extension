{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "object",
  "properties": {
    "_policyVersion": {
      "type": "integer",
      "description": "Policy revision number for tracking deployed configuration versions."
    },
    "_locked": {
      "type": "object",
      "description": "Map of dot-path setting keys to boolean. When true, the setting cannot be changed by the user. Parent paths lock all children (e.g., 'aiChatGuard' locks 'aiChatGuard.enabled').",
      "properties": {
        "detectionMode": { "type": "boolean" },
        "enableVectorFallback": { "type": "boolean" },
        "vectorThreshold": { "type": "boolean" },
        "regexAfterAi": { "type": "boolean" },
        "showRedactButton": { "type": "boolean" },
        "enableContentEditable": { "type": "boolean" },
        "enableDocumentUpload": { "type": "boolean" },
        "sessionTimeoutMinutes": { "type": "boolean" },
        "siteFilter": { "type": "boolean" },
        "aiChatGuard": { "type": "boolean" },
        "aiChatGuard.enabled": { "type": "boolean" },
        "autoRedact": { "type": "boolean" },
        "autoRedact.enabled": { "type": "boolean" },
        "submitGuard": { "type": "boolean" },
        "submitGuard.enabled": { "type": "boolean" },
        "uploadGuard": { "type": "boolean" },
        "uploadGuard.enabled": { "type": "boolean" },
        "voiceDetection": { "type": "boolean" },
        "voiceDetection.enabled": { "type": "boolean" },
        "voiceDetection.warnOnLeak": { "type": "boolean" },
        "voiceDictation": { "type": "boolean" },
        "voiceDictation.enabled": { "type": "boolean" },
        "voiceDictation.suppressNativeMic": { "type": "boolean" },
        "reversibleTokenization": { "type": "boolean" },
        "reversibleTokenization.enabled": { "type": "boolean" },
        "providers": { "type": "boolean" },
        "providers.local_ai": { "type": "boolean" },
        "providers.azure_pii": { "type": "boolean" },
        "providers.purview": { "type": "boolean" },
        "providers.hosted": { "type": "boolean" },
        "debugMode": { "type": "boolean" }
      },
      "additionalProperties": { "type": "boolean" }
    },
    "detectionMode": {
      "type": "string",
      "enum": ["auto", "ai_only", "regex_only", "hosted_only", "cloud_only"],
      "description": "PII detection mode. 'auto' runs deterministic local detection first and may progressively enhance it with enabled providers."
    },
    "enableVectorFallback": {
      "type": "boolean",
      "description": "Enable heuristic name detection alongside regex."
    },
    "vectorThreshold": {
      "type": "number",
      "description": "Confidence threshold for vector name detection (0.0–1.0)."
    },
    "regexAfterAi": {
      "type": "boolean",
      "description": "Run regex after AI for extra safety (belt-and-suspenders mode)."
    },
    "showRedactButton": {
      "type": "boolean",
      "description": "Show the Redact PII button on text fields."
    },
    "enableContentEditable": {
      "type": "boolean",
      "description": "Attach redaction to contenteditable elements."
    },
    "enableDocumentUpload": {
      "type": "boolean",
      "description": "Enable document upload and redaction."
    },
    "sessionTimeoutMinutes": {
      "type": "integer",
      "description": "Idle timeout before destroying the AI session (minutes)."
    },
    "debugMode": {
      "type": "boolean",
      "description": "Enable debug logging to browser console."
    },
    "siteFilter": {
      "type": "object",
      "description": "Controls which sites the extension activates on.",
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["all", "whitelist", "blacklist"]
        },
        "whitelist": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Site patterns for whitelist mode."
        },
        "blacklist": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Site patterns for blacklist mode."
        }
      }
    },
    "aiChatGuard": {
      "type": "object",
      "description": "AI chat service protection settings.",
      "properties": {
        "enabled": { "type": "boolean" },
        "autoRedactOnAiSites": { "type": "boolean" },
        "blockSubmitUntilRedacted": { "type": "boolean" },
        "interceptUploads": { "type": "boolean" },
        "showAiBanner": { "type": "boolean" },
        "customAiDomains": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Additional domains to treat as AI chat services."
        }
      }
    },
    "autoRedact": {
      "type": "object",
      "description": "Auto-redact on type/paste settings.",
      "properties": {
        "enabled": { "type": "boolean" },
        "debounceMs": { "type": "integer" },
        "onPaste": { "type": "boolean" },
        "onlyOnAiSites": { "type": "boolean" }
      }
    },
    "submitGuard": {
      "type": "object",
      "description": "Submit/send interception settings.",
      "properties": {
        "enabled": { "type": "boolean" },
        "interceptEnter": { "type": "boolean" },
        "interceptFormSubmit": { "type": "boolean" },
        "interceptSendButtons": { "type": "boolean" },
        "onlyOnAiSites": { "type": "boolean" }
      }
    },
    "uploadGuard": {
      "type": "object",
      "description": "File upload interception settings.",
      "properties": {
        "enabled": { "type": "boolean" },
        "onlyOnAiSites": { "type": "boolean" },
        "confirmBeforeUpload": { "type": "boolean" },
        "allowBypass": {
          "type": "boolean",
          "description": "Permit release of an original file when inspection fails. Keep false for fail-closed deployments."
        },
        "blockUnsupported": {
          "type": "boolean",
          "description": "Block formats the extension cannot inspect. Keep true for fail-closed deployments."
        },
        "maxFileSizeBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 26214400,
          "description": "Maximum file size accepted by the browser pipeline (hard maximum 25 MiB)."
        }
      }
    },
    "voiceDetection": {
      "type": "object",
      "description": "Microphone-capture (voice dictation) detection settings.",
      "properties": {
        "enabled": { "type": "boolean" },
        "warnOnLeak": { "type": "boolean" },
        "language": { "type": "string", "description": "BCP-47 language tag for on-device transcription (e.g., en-US)." }
      }
    },
    "voiceDictation": {
      "type": "object",
      "description": "Inline on-device voice dictation on AI-chat composers.",
      "properties": {
        "enabled": { "type": "boolean" },
        "suppressNativeMic": { "type": "boolean" }
      }
    },
    "reversibleTokenization": {
      "type": "object",
      "description": "Replace PII with unique reversible tokens instead of generic masks.",
      "properties": {
        "enabled": { "type": "boolean" }
      }
    },
    "providers": {
      "type": "object",
      "description": "Provider configuration. Admin can pre-configure cloud provider credentials.",
      "properties": {
        "local_ai": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" }
          }
        },
        "regex": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" }
          }
        },
        "azure_pii": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "connectionMode": { "type": "string", "enum": ["direct", "enterprise"], "description": "'direct' uses API key, 'enterprise' uses Azure AD OAuth2 PKCE." },
            "endpoint": { "type": "string" },
            "apiKey": { "type": "string" },
            "apiVersion": { "type": "string" },
            "language": { "type": "string" },
            "domain": { "type": "string", "enum": ["none", "phi"] },
            "categoriesFilter": { "type": "array", "items": { "type": "string" } },
            "tenantId": { "type": "string", "description": "Azure AD tenant ID (GUID) for Enterprise mode." },
            "clientId": { "type": "string", "description": "Azure AD App Registration client ID for Enterprise mode." },
            "nativeDocEnabled": { "type": "boolean" },
            "sourceContainerUrl": { "type": "string" },
            "targetContainerUrl": { "type": "string" },
            "redactionPolicy": { "type": "string", "enum": ["entityMask", "characterMask"] }
          }
        },
        "purview": {
          "type": "object",
          "properties": {
            "gateEnabled": { "type": "boolean", "description": "Enable the local pre-upload gate for embedded Microsoft sensitivity labels." },
            "blockedLabels": { "type": "array", "items": { "type": "string" }, "description": "Sensitivity label names to block (e.g., PROTECTED, SECRET)." },
            "warnLabels": { "type": "array", "items": { "type": "string" }, "description": "Sensitivity label names to warn about but allow." },
            "blockEncrypted": { "type": "boolean", "description": "Block files with embedded encryption/protection markers." }
          }
        },
        "hosted": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "enabled": { "type": "boolean" },
              "providerId": { "type": "string" },
              "displayName": { "type": "string" },
              "endpoint": { "type": "string" },
              "apiKey": { "type": "string" },
              "apiMode": { "type": "string", "enum": ["openai", "pii_api", "ocr_extract"] },
              "model": { "type": "string" },
              "maxTokens": { "type": "integer" },
              "timeout": { "type": "integer" },
              "priority": { "type": "integer" }
            }
          }
        }
      }
    },
    "configUrl": {
      "type": "string",
      "description": "URL to a remote JSON configuration file (for small-business deployment without MDM)."
    }
  }
}
