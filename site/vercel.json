{
  "rewrites": [
    { "source": "/privacy", "destination": "/index.html#privacy" },
    { "source": "/support", "destination": "/index.html#support" },
    { "source": "/enterprise", "destination": "/index.html#enterprise" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
