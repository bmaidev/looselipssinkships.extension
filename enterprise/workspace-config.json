{
  "_policyVersion": 2,
  "_locked": {
    "detectionMode": true,
    "aiChatGuard.enabled": true,
    "submitGuard.enabled": true,
    "uploadGuard.enabled": true,
    "providers.azure_pii": true,
    "providers.purview.gateEnabled": true,
    "providers.purview.blockedLabels": true
  },
  "detectionMode": "cloud_only",
  "aiChatGuard": {
    "enabled": true,
    "autoRedactOnAiSites": true,
    "blockSubmitUntilRedacted": true,
    "interceptUploads": true,
    "showAiBanner": true,
    "customAiDomains": [
      "internal-ai.yourorg.com"
    ]
  },
  "submitGuard": {
    "enabled": true,
    "interceptEnter": true,
    "interceptFormSubmit": true,
    "interceptSendButtons": true,
    "onlyOnAiSites": true
  },
  "uploadGuard": {
    "enabled": true,
    "onlyOnAiSites": true,
    "confirmBeforeUpload": true
  },
  "siteFilter": {
    "mode": "all",
    "whitelist": [],
    "blacklist": []
  },
  "providers": {
    "local_ai": {
      "enabled": true
    },
    "azure_pii": {
      "enabled": true,
      "connectionMode": "enterprise",
      "endpoint": "https://YOUR-INSTANCE.cognitiveservices.azure.com",
      "tenantId": "YOUR_TENANT_ID",
      "clientId": "YOUR_APP_REGISTRATION_CLIENT_ID",
      "apiVersion": "2023-04-01",
      "language": "en",
      "domain": "none",
      "nativeDocEnabled": true,
      "sourceContainerUrl": "https://YOUR-STORAGE.blob.core.windows.net/llss-source",
      "targetContainerUrl": "https://YOUR-STORAGE.blob.core.windows.net/llss-target",
      "redactionPolicy": "entityMask"
    },
    "purview": {
      "enabled": true,
      "gateEnabled": true,
      "blockedLabels": ["PROTECTED", "SECRET", "TOP SECRET"],
      "warnLabels": ["OFFICIAL: Sensitive"],
      "blockEncrypted": true,
      "tenantId": "YOUR_TENANT_ID",
      "clientId": "YOUR_APP_REGISTRATION_CLIENT_ID"
    }
  }
}
